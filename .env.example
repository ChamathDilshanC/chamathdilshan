# =============================================================
#  MASTER environment variable list — Personal Portfolio Platform
#  Copy the relevant subset into each app's own .env
#    frontend -> chamathdilshan.dev/.env.local
#    backend  -> api.chamathdilshan.dev/.env
#  NEVER commit a real .env file.  (SECURITY.md §11, §12)
# =============================================================

# -------------------------------------------------------------
# FRONTEND (chamathdilshan.dev) — Next.js
# NEXT_PUBLIC_* values are exposed to the browser. Nothing secret here.
# -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://chamathdilshan.dev
NEXT_PUBLIC_API_URL=https://api.chamathdilshan.dev

# Server-only in the frontend (used by /api/revalidate)
CACHE_REVALIDATE_SECRET=

# -------------------------------------------------------------
# BACKEND (api.chamathdilshan.dev) — FastAPI
# -------------------------------------------------------------
APP_ENV=development
APP_DEBUG=false
PUBLIC_SITE_URL=https://chamathdilshan.dev
NEXT_APP_URL=https://chamathdilshan.dev
ALLOWED_ORIGINS=https://chamathdilshan.dev

# -------------------------------------------------------------
# Database — Supabase PostgreSQL (session pooler, port 5432)
#   postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local development: sqlite+aiosqlite:///./dev.db
# -------------------------------------------------------------
DATABASE_URL=

# -------------------------------------------------------------
# Media — Cloudinary (images + videos)  (docs/ADMIN_CMS.md)
# CLOUDINARY_API_SECRET is server-only. Never expose it.
# -------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=chamathdilshan.dev
CLOUDINARY_SIGNATURE_ALGORITHM=sha1

# -------------------------------------------------------------
# Admin sign-in — Google + emailed one-time code  (SECURITY.md §4, §5, §10)
# GOOGLE_CLIENT_SECRET and RESEND_API_KEY are server-only.
# -------------------------------------------------------------
ADMIN_EMAIL=chamathdilshan.dev@gmail.com
ADMIN_GOOGLE_SUB=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.chamathdilshan.dev/api/auth/google/callback
RESEND_API_KEY=
RESEND_FROM=chamathdilshan.dev <auth@chamathdilshan.dev>

# -------------------------------------------------------------
# Sessions & security
# -------------------------------------------------------------
SESSION_SECRET=
SESSION_COOKIE_NAME=pf_session
SESSION_MAX_AGE=86400

# -------------------------------------------------------------
# Caching  (CACHING.md §17)
# -------------------------------------------------------------
REDIS_URL=
CACHE_NAMESPACE=pf:v1
CACHE_DEFAULT_TTL=3600
CACHE_ENABLED=true

# Optional CDN purge, only if ISR coverage is insufficient
CDN_PURGE_URL=
CDN_PURGE_TOKEN=

# -------------------------------------------------------------
# Rate limiting  (SECURITY.md §20)
# -------------------------------------------------------------
RATE_LIMIT_AUTH_PER_MINUTE=10

# -------------------------------------------------------------
# Observability
# -------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
